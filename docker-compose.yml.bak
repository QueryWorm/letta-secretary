services:
  letta-db:
    image: pgvector/pgvector:pg16
    environment:
      POSTGRES_USER: letta
      POSTGRES_PASSWORD: letta
      POSTGRES_DB: letta
    volumes:
      - ./pgdata:/var/lib/postgresql/data
    restart: unless-stopped
  letta-server:
    image: letta/letta:latest
    environment:
      LETTA_PG_URI: postgresql://letta:letta@letta-db:5432/letta
      OPENROUTER_API_KEY: ${OPENROUTER_API_KEY}
      GROQ_API_KEY: ${GROQ_API_KEY}
      CEREBRAS_API_KEY: ${CEREBRAS_API_KEY}
      GEMINI_API_KEY: ${GEMINI_API_KEY}
      LETTA_API_KEY: ${LETTA_API_KEY}
      SAMBANOVA_API_KEY: ${SAMBANOVA_API_KEY}
      LETTA_BASE_URL: http://letta-server:8283
      ENV_NAME: secretary-whatsapp
      ENV_NAME: secretary-whatsapp
      TZ: Europe/Kyiv
    ports:
      - "8283:8283"
    volumes:
      - attachments-data:/tmp/lettabot/attachments
    depends_on:
      - letta-db
    restart: unless-stopped
  searxng:
    image: searxng/searxng:latest
    ports:
      - "8080:8080"
    environment:
      - SEARXNG_BASE_URL=http://localhost:8080/
    volumes:
      - ./searxng/settings.yml:/etc/searxng/settings.yml
    restart: unless-stopped
  lettabot:
    build: ./lettabot
    depends_on:
      - letta-server
    volumes:
      - ./lettabot/lettabot.yaml:/app/lettabot.yaml
      - lettabot-data:/app/data
      - attachments-data:/tmp/lettabot/attachments
      - lettabot-credentials:/root/.lettabot
      - lettabot-todos:/app/todos
    env_file:
      - .env
    restart: unless-stopped
    environment:
      LETTABOT_API_KEY: d21ccb3a6f74d562c4daf4106970398b604793d679985ca33080546f402e4f8f
      OPENAI_API_KEY: sk-anything
      OPENAI_TRANSCRIPTION_BASE_URL: http://litellm:4000
      TZ: Europe/Kyiv
      LETTA_BASE_URL: http://letta-server:8283
      ENV_NAME: secretary-whatsapp
      DATABASE_URL: postgresql://letta:letta@letta-db:5432/letta
  letta-code-channels:
    build: ./letta-code-channels
    depends_on:
      - letta-server
    env_file:
      - .env
    environment:
      LETTA_BASE_URL: http://letta-server:8283
      ENV_NAME: secretary-whatsapp
      TZ: Europe/Kyiv
    volumes:
      - letta-code-data:/root/.letta
    command: ["server", "--channels", "whatsapp"]
    restart: unless-stopped
  litellm:
    image: ghcr.io/berriai/litellm:main-latest
    ports:
      - 4000:4000
    volumes:
      - ./litellm-config.yaml:/app/config.yaml
    command:
      - --config
      - /app/config.yaml
    env_file:
      - .env
    restart: unless-stopped
    environment:
      TZ: Europe/Kyiv
      LITELLM_LOG: DEBUG
volumes:
  lettabot-data:
  attachments-data:
  lettabot-credentials: {}
  lettabot-todos: {}
  letta-code-data: {}
